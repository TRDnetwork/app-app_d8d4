{
  "name": "shopsphere-monorepo",
  "version": "1.0.0",
  "description": "Amazon-like e-commerce platform with React, Express, MongoDB",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "seed": "node server/src/utils/seed.js --seed",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "npm start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "vitest": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "express": "latest",
    "jsonwebtoken": "latest",
    "http-status-codes": "latest",
    "bcryptjs": "latest",
    "validator": "latest",
    "mongoose": "latest",
    "passport": "latest",
    "passport-google-oauth20": "latest",
    "passport-facebook": "latest",
    "react": "^18.3.1",
    "i18next": "latest",
    "react-i18next": "latest",
    "i18next-browser-languagedetector": "latest",
    "@stripe/react-stripe-js": "latest",
    "@stripe/stripe-js": "latest",
    "react-router-dom": "^6.26.0",
    "stripe": "^16.2.0",
    "mongodb": "latest",
    "csv-parse": "latest",
    "jsonc-parser": "latest",
    "csv-stringify": "latest",
    "react-dom": "^18.3.1",
    "axios": "^1.7.0",
    "zustand": "latest",
    "lucide-react": "^0.400.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@vercel/node": "^3.2.0",
    "resend": "^3.2.0"
  }
}