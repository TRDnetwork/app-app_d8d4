# Frontend
VITE_API_URL=http://localhost:5000
VITE_CLIENT_URL=http://localhost:5173
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production

# Database
MONGODB_URI=mongodb://localhost:27017/shopsphere
MONGODB_DB_NAME=shopsphere

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_RATE_LIMIT_MAX=3

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=/api/auth/oauth/google/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=/api/auth/oauth/facebook/callback

# Email
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=your_email_username
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=ShopSphere <noreply@shopsphere.com>
RESEND_API_KEY=your_resend_api_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_JS_URL=https://js.stripe.com
STRIPE_API_URL=https://api.stripe.com

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=shopsphere-products
S3_BUCKET_URL=https://shopsphere-products.s3.amazonaws.com
USE_S3=true
MAX_FILE_SIZE=10485760

# Analytics
GOOGLE_ANALYTICS_ID=your_google_analytics_id
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_API_HOST=https://app.posthog.com

# Search
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_SEARCH_KEY=your_algolia_search_key
ALGOLIA_ADMIN_KEY=your_algolia_admin_key
ALGOLIA_INDEX_NAME=products

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_FILE_LOGGING=false
LOG_DIRECTORY=./logs
MAX_FILE_SIZE=10m
MAX_FILES=14d

# Server
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
API_PREFIX=/api

# User Roles
USER_ROLE_CUSTOMER=customer
USER_ROLE_SELLER=seller
USER_ROLE_ADMIN=admin

# Payment
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Notifications
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# Security Headers
GOOGLE_FONTS_URL=https://fonts.googleapis.com
```

