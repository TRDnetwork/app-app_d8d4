# Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://shopsphere-backend.onrender.com
NEXT_PUBLIC_CLIENT_URL=https://shopsphere.vercel.app

# Backend Environment Variables (for reference — set in backend's environment)
# JWT_SECRET=your_jwt_secret_key_here_change_in_production
# JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopsphere
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_PORT=587
# EMAIL_USERNAME=your_email_username
# EMAIL_PASSWORD=your_email_password
# EMAIL_FROM=noreply@shopsphere.com
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=shopsphere-products

# Optional: Analytics
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: Sentry
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0