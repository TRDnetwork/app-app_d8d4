# Application Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/shopsphere
MONGODB_DB_NAME=shopsphere

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Payment Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Email Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=ShopSphere <onboarding@resend.dev>

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name_here

# Search Configuration
ALGOLIA_APP_ID=your_algolia_app_id_here
ALGOLIA_ADMIN_KEY=your_algolia_admin_key_here
ALGOLIA_SEARCH_KEY=your_algolia_search_key_here

# Analytics Configuration
SENTRY_DSN=your_sentry_dsn_here
POSTHOG_API_KEY=your_posthog_api_key_here

# Frontend Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_ALGOLIA_APP_ID=your_algolia_app_id_here
VITE_ALGOLIA_SEARCH_KEY=your_algolia_search_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_RATE_LIMIT_MAX=3

# Logging
LOG_LEVEL=info

# Security
CSP_STRIPE_JS_URL=https://js.stripe.com
CSP_GOOGLE_FONTS_URL=https://fonts.googleapis.com

# Monitoring
HEALTH_CHECK_WEBHOOK_URL=https://your-webhook-url.com/health-check

# File Upload
MAX_FILE_SIZE=10485760
USE_S3=true

# Notification
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# Payment
ENABLE_STRIPE=true
ENABLE_PAYPAL=false

# Search
SEARCH_PROVIDER=algolia

# Multi-language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ja

# Currency
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,GBP,JPY,CAD

# Theme
DEFAULT_THEME=light
SUPPORTED_THEMES=light,dark

# Cache
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Background Jobs
BULL_BOARD_ENABLED=false
BULL_REDIS_URL=redis://localhost:6379

# Monitoring
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
```

