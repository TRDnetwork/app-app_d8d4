```env
# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net

# Database Name
DB_NAME=shopsphere

# JWT Secrets (use strong random strings)
JWT_SECRET=your_jwt_secret_here_replace_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_replace_in_production

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLIC_KEY=pk_test_...

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_secret

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_secret

# Email (Resend or similar)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@shopsphere.com

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=shopsphere-media

# Algolia / Elasticsearch
ALGOLIA_APP_ID=your_app_id
ALGOLIA_API_KEY=your_admin_key
ALGOLIA_INDEX_NAME=products

# Server
PORT=3001
NODE_ENV=development

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api
VITE_STRIPE_KEY=pk_test_...
```