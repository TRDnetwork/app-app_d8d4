# Frontend environment variables (prefixed for Vite)
VITE_API_URL=your-api-url  # Base URL for the Express backend (e.g., https://shopsphere-server.onrender.com)
VITE_CLIENT_URL=your-client-url  # Base URL for the frontend (e.g., https://shopsphere.vercel.app)
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key  # Stripe publishable key for client-side payments

# Backend environment variables (used by Express server)
JWT_SECRET=your-jwt-secret-key  # Secret key for signing JWT tokens
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key  # Secret key for signing refresh tokens
MONGODB_URI=your-mongodb-uri  # MongoDB connection string (e.g., mongodb+srv://...)
STRIPE_SECRET_KEY=your-stripe-secret-key  # Stripe secret key for server-side operations
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret  # Stripe webhook signing secret
RESEND_API_KEY=your-resend-api-key  # API key for sending transactional emails
GOOGLE_CLIENT_ID=your-google-client-id  # Google OAuth client ID
GOOGLE_CLIENT_SECRET=your-google-client-secret  # Google OAuth client secret
FACEBOOK_APP_ID=your-facebook-app-id  # Facebook OAuth app ID
FACEBOOK_APP_SECRET=your-facebook-app-secret  # Facebook OAuth app secret
AWS_ACCESS_KEY_ID=your-aws-access-key-id  # AWS access key for S3
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key  # AWS secret key for S3
S3_BUCKET_NAME=your-s3-bucket-name  # AWS S3 bucket name for product images
REDIS_HOST=your-redis-host  # Redis host for job queues (e.g., localhost)
REDIS_PORT=your-redis-port  # Redis port (e.g., 6379)
REDIS_PASSWORD=your-redis-password  # Redis password (if required)
REDIS_TLS=true-or-false  # Whether to use TLS for Redis connection
UPLOAD_DIR=/tmp/shopsphere-imports  # Directory for temporary file uploads (server-side)
NODE_ENV=production  # Environment mode (development, production)
PORT=3001  # Port for the Express server (e.g., 3001)
SERVER_URL=your-server-url  # Base URL for the server (e.g., https://shopsphere-server.onrender.com)
CLIENT_URL=your-client-url  # Base URL for the frontend (e.g., https://shopsphere.vercel.app)
LOG_LEVEL=info  # Logging level (debug, info, warn, error)