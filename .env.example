# Frontend API URL - used in client-side fetch calls
NEXT_PUBLIC_API_URL=http://localhost:5000

# Backend configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# Database - MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/shopsphere

# OAuth - Google Authentication
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - Facebook Authentication
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Email service configuration
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USERNAME=your-email-username
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@shopsphere.com

# Stripe Payment Processing
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=shopsphere-products

# Resend Email Service (alternative)
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_RESEND_API_KEY=your-resend-api-key

# Supabase (if needed for any features)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Analytics
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-url
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Environment
NEXT_PUBLIC_APP_ENV=development

# AI/ML Services (if enabled later)
OPENAI_API_KEY=your-openai-api-key

# Search Service
ELASTICSEARCH_URL=http://localhost:9200
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_SEARCH_KEY=your-algolia-search-key
ALGOLIA_ADMIN_KEY=your-algolia-admin-key