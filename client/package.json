    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.2",
    "vite": "^4.3.9",
    "@sentry/cli": "^2.20.1",
    "eslint": "^8.38.0",
    "vitest": "^0.34.4"
  }
}
